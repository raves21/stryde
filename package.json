{
  "name": "stryde",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"bun run --filter @stryde/api dev\" \"bun run --filter @stryde/web dev\"",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --filter @stryde/api db:generate",
    "db:migrate": "bun run --filter @stryde/api db:migrate",
    "e2e": "bun run --filter @stryde/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
