# Copy to .env next to compose.yml on the server (never commit the real file).
# docs/deploy-home-server.md explains every value.

NODE_ENV=production
PORT=3000

# Image tag to run; the deploy workflow rewrites this line with the commit SHA.
IMAGE_TAG=latest

# Public origin of the app (no trailing slash). Better Auth base URL; the Google
# redirect URI is ${PUBLIC_URL}/api/auth/callback/google. Dev: http://localhost:5173
PUBLIC_URL=https://stryde.obnsolutions.org

# Postgres password (used by both containers; compose builds DATABASE_URL from it).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google OAuth (optional: the Google button reports "not set up" without these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Docker network the cloudflared container is on (`docker network ls`).
TUNNEL_NETWORK=cf_tunnel

# Avatars (later); mounted volume in compose.
UPLOAD_DIR=/data/uploads

# Set by the image build; reported by /api/health. Don't set it here.
# GIT_SHA=

# Dev only: set to 1 to enable auth rate limiting outside production.
# AUTH_RATE_LIMIT=1
