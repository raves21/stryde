# Copy to docker/.env (never commit the real file). Filled in as phases add variables.

NODE_ENV=production
PORT=3000
# Set by the image build; reported by /api/health.
# GIT_SHA=

# Public origin of the app (no trailing slash). Better Auth base URL; the Google
# redirect URI is ${PUBLIC_URL}/api/auth/callback/google. Dev: http://localhost:5173
PUBLIC_URL=https://gym.example.com

DATABASE_URL=postgres://stryde:change-me@db:5432/stryde
POSTGRES_PASSWORD=change-me

# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google OAuth (optional: the Google button reports "not set up" without these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev only: set to 1 to enable auth rate limiting outside production.
# AUTH_RATE_LIMIT=1
